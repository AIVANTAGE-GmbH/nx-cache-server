{
  "imports": {
    "@aws-sdk/client-s3": "npm:@aws-sdk/client-s3@^3.1156.0",
    "@aws-sdk/lib-storage": "npm:@aws-sdk/lib-storage@~3.1156.0",
    "@aws-sdk/s3-request-presigner": "npm:@aws-sdk/s3-request-presigner@^3.1156.0",
    "@david/dax": "jsr:@david/dax@^0.50.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/testing": "jsr:@std/testing@^1.0.21",
    "emulate": "npm:emulate@^0.12.3",
    "hono": "npm:hono@^4.13.13"
  },
  "fmt": {
    "singleQuote": true,
    "exclude": ["charts/"]
  },
  "lint": {
    "exclude": ["charts/"]
  },
  "tasks": {
    "start": "deno run --allow-env --allow-net --allow-sys --allow-read --env-file=.env src/index.ts",
    "dev": "deno run --watch --allow-env --allow-net --allow-sys --allow-read --env-file=.env.local src/index.ts",
    "emulate": "deno run --allow-env --allow-net --allow-sys --allow-read scripts/start-emulator.ts",
    "test": "deno test --allow-env --allow-net --allow-sys --allow-read --env-file=.env.local src/**/*.test.ts",
    "e2e": "deno test --allow-env --allow-net --allow-sys --allow-read --allow-write --allow-run --env-file=.env.local e2e/**/*.test.ts"
  }
}
